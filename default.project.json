{
	"name": "StealASnackling",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/shared"
			},
			"CreatureModels": {
				"$className": "Folder",
				"$ignoreUnknownInstances": true
			}
		},
		"ServerScriptService": {
			"Server": {
				"$path": "src/server"
			},
			"ServerPackages": {
				"$path": {
					"optional": "ServerPackages"
				}
			}
		},
		"StarterPlayer": {
			"StarterPlayerScripts": {
				"Client": {
					"$path": "src/client"
				}
			}
		},
		"TextChatService": {
			"$properties": {
				"ChatVersion": "TextChatService"
			}
		},
		"Workspace": {
			"$properties": {
				"StreamingEnabled": false
			}
		}
	}
}
