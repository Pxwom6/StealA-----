--!strict
local T = require("./TestKit")
local Guard = require("../src/shared/Logic/Guard")

T.describe("Guard", function()
	T.it("accepts finite numbers only", function()
		T.expect(Guard.isFiniteNumber(3.5)).toBe(true)
		T.expect(Guard.isFiniteNumber(0 / 0)).toBe(false)
		T.expect(Guard.isFiniteNumber(math.huge)).toBe(false)
		T.expect(Guard.isFiniteNumber("3")).toBe(false)
		T.expect(Guard.isFiniteNumber(nil)).toBe(false)
	end)
	T.it("validates integers in range", function()
		T.expect(Guard.integer(3, 1, 8)).toBe(3)
		T.expect(Guard.integer(0, 1, 8)).toBeNil()
		T.expect(Guard.integer(9, 1, 8)).toBeNil()
		T.expect(Guard.integer(2.5, 1, 8)).toBeNil()
		T.expect(Guard.integer(0 / 0, 1, 8)).toBeNil()
		T.expect(Guard.integer(-math.huge, -math.huge, 8)).toBeNil()
		T.expect(Guard.integer({}, 1, 8)).toBeNil()
		T.expect(Guard.integer("3", 1, 8)).toBeNil()
	end)
	T.it("validates short strings", function()
		T.expect(Guard.shortString("hello", 10)).toBe("hello")
		T.expect(Guard.shortString("", 10)).toBeNil()
		T.expect(Guard.shortString(string.rep("x", 11), 10)).toBeNil()
		T.expect(Guard.shortString(42, 10)).toBeNil()
	end)
	T.it("validates enum-like strings", function()
		T.expect(Guard.oneOf("store_opened", { "store_opened" })).toBe("store_opened")
		T.expect(Guard.oneOf("anything", { "store_opened" })).toBeNil()
		T.expect(Guard.keyOf("CashSmall", { CashSmall = 1 })).toBe("CashSmall")
		T.expect(Guard.keyOf("__index", { CashSmall = 1 })).toBeNil()
		T.expect(Guard.keyOf(true, { CashSmall = 1 })).toBeNil()
	end)
end)

return nil
