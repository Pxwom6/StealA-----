--!strict
local T = require("./TestKit")
local Format = require("../src/shared/Logic/Format")

T.describe("Format.number", function()
	T.it("keeps small whole numbers exact", function()
		T.expect(Format.number(0)).toBe("0")
		T.expect(Format.number(7)).toBe("7")
		T.expect(Format.number(999)).toBe("999")
	end)
	T.it("shows one decimal for small fractions, rounded down", function()
		T.expect(Format.number(1.5)).toBe("1.5")
		T.expect(Format.number(0.25)).toBe("0.2")
		T.expect(Format.number(0.04)).toBe("0")
	end)
	T.it("abbreviates with three significant digits, rounding down", function()
		T.expect(Format.number(1000)).toBe("1K")
		T.expect(Format.number(1500)).toBe("1.5K")
		T.expect(Format.number(1239)).toBe("1.23K")
		T.expect(Format.number(12345)).toBe("12.3K")
		T.expect(Format.number(123456)).toBe("123K")
		T.expect(Format.number(999999)).toBe("999K")
		T.expect(Format.number(1e6)).toBe("1M")
		T.expect(Format.number(2.5e9)).toBe("2.5B")
		T.expect(Format.number(1e12)).toBe("1T")
		T.expect(Format.number(4.56e15)).toBe("4.56Qa")
	end)
	T.it("handles every exact power of 1000 without '1000K' artefacts", function()
		for tier = 1, 11 do
			local text = Format.number(1000 ^ tier)
			T.expect(string.sub(text, 1, 1)).toBe("1")
			T.expect((string.find(text, "1000", 1, true))).toBeNil()
		end
	end)
	T.it("handles negatives, NaN, infinity and huge values", function()
		T.expect(Format.number(-1500)).toBe("-1.5K")
		T.expect(Format.number(0 / 0)).toBe("0")
		T.expect(Format.number(math.huge)).toBe("inf")
		T.expect((string.find(Format.number(1e40), "e+", 1, true))).toBeTruthy()
	end)
end)

T.describe("Format.cash", function()
	T.it("prefixes the currency symbol", function()
		T.expect(Format.cash(1500)).toBe("$1.5K")
		T.expect(Format.cash(25, "C")).toBe("C25")
		T.expect(Format.cash(-10)).toBe("-$10")
	end)
end)

T.describe("Format.clock / duration", function()
	T.it("formats countdowns", function()
		T.expect(Format.clock(75)).toBe("1:15")
		T.expect(Format.clock(3725)).toBe("1:02:05")
		T.expect(Format.clock(-5)).toBe("0:00")
		T.expect(Format.clock(0.2)).toBe("0:01")
	end)
	T.it("formats long durations with two units", function()
		T.expect(Format.duration(45)).toBe("45s")
		T.expect(Format.duration(303)).toBe("5m 3s")
		T.expect(Format.duration(3725)).toBe("1h 2m")
		T.expect(Format.duration(90000)).toBe("1d 1h")
	end)
end)

T.describe("Format.percent", function()
	T.it("keeps tiny odds readable", function()
		T.expect(Format.percent(0.5)).toBe("50%")
		T.expect(Format.percent(0.0123)).toBe("1.23%")
		T.expect(Format.percent(0.00018)).toBe("0.018%")
		T.expect(Format.percent(0.0000123)).toBe("0.0012%")
		T.expect(Format.percent(0)).toBe("0%")
	end)
end)

T.describe("Format.template", function()
	T.it("fills placeholders and leaves unknown ones visible", function()
		T.expect(Format.template("{a} stole {b}!", { a = "Ana", b = 3 })).toBe("Ana stole 3!")
		T.expect(Format.template("Hi {who}", {})).toBe("Hi {who}")
		T.expect(Format.template("plain", nil)).toBe("plain")
	end)
end)

return nil
